output ["start  : ",show(start),"\n","free   : ",show(free),"\n","prep   : ",show(prep),"\n","end    : ",show(end),"\n","rescued: ",show(rescued),"\n","z      : ",show(z),"\n"];
int: k = 8;
array [1..k] of int: rescued;
int: z = sum(rescued);
array [1..k] of int: end;
array [1..k] of int: prep = [15,5,15,5,10,15,10,5];
array [1..k] of int: free = [1,1,2,2,3,4,5,6];
array [1..k] of int: start;
