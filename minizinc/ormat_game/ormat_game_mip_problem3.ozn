output let {array [int] of string: X_INTRODUCED_35_ = (((["Problem:"]++[if j==1 then "\n" else "" endif++show(problem[i,j]) | i,j in 1..n])++["\n\nSolution:\nx: ",show(x),"\n","num_overlays: ",show(num_overlays),"\n"])++[((if fix(x[o])==1 /\ j==1 then "\n" else "" endif++if fix(x[o])==1 /\ i==1 /\ j==1 then ("Overlay #"++show(o))++"\n" else "" endif)++if fix(x[o])==1 then show(overlays[o,i,j]) else "" endif)++if fix(x[o])==1 /\ i==n /\ j==n then "\n" else "" endif | o in 1..f, i,j in 1..n])++["\n"]} in (X_INTRODUCED_35_);
