output [((((((("x: "++show(x))++"\n")++"diffs: ")++show(diffs))++"\n")++"diffs_sum: ")++show(diffs_sum))++"\n"]++[((("test "++show(t))++": ")++show(sum([scores_test[t,i]*fix(x[i]) | i in 1..3])))++"\n" | t in 1..3];
