output (((([((("total cost: "++show(total_cost))++"\n")++"x: ")++show(x)]++["\n"])++[if fix(x[i]==1) then ((((((((show(names[i])++"\t")++show(salary[i]))++"   ")++show(skills[i,1]))++"  ")++show(skills[i,2]))++"  ")++show(skills[i,3]))++"\n" else "" endif | i in 1..n])++["Sum skills: "])++[show(sum_skills[j])++" " | j in 1..num_skills])++["\n"];
int: n = 9;
array [1..n] of int: x;
array [1..n] of int: salary = [46,43,47,36,43,55,68,64,60];
int: total_cost = sum([x[i]*salary[i] | i in 1..n]);
array [1..n] of string: names = ["Amy","Bill","Carl","Dan","Eva","Fred","Greg","Henry","Ida"];
int: num_skills = 3;
array [1..n,1..num_skills] of int: skills = [|3,5,1|1,2,5|3,4,2|4,3,1|4,2,2|1,3,4|3,1,5|5,4,2|3,3,3|];
array [1..num_skills] of int: sum_skills = [sum([skills[i,j]*x[i] | i in 1..n]) | j in 1..num_skills];
