output ([(((((((("num_purgings: "++show(num_purgings))++"\n")++"distance    : ")++show(distance))++"\n")++"x           : ")++show(x))++"\n")++"x(colors)   : "]++[show(col_str[colors[fix(x[i])]])++" " | i in 1..n])++["\n"];
