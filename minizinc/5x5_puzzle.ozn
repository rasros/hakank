output [(if i==1 /\ j==1 then "\nThe_sum: "++show(the_sum) else "" endif++if j==1 then "\n" else " " endif)++show(x[i,j]) | i in N, j in N];
set of int: N = 1..5;
array [1..25] of int: X_INTRODUCED_0_;
array [N,N] of int: x = array2d(1..5,1..5,X_INTRODUCED_0_);
int: the_sum = sum([x[i,j] | i in N, j in N]);
