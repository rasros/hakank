array [1..num_companies] of int: open;
int: tot_cost;
int: num_regions = 3;
array [1..12] of int: X_INTRODUCED_4_;
array [1..num_companies,1..num_regions] of int: ships = array2d(1..4,1..3,X_INTRODUCED_4_);
