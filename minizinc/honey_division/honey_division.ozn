output let {array [int] of string: X_INTRODUCED_25_ = (["sumx: ",show(sumx)]++[if j==1 then "\n" else " " endif++show(x[i,j]) | i in S, j in C])++["\n"]} in (X_INTRODUCED_25_);
set of int: C = 1..3;
set of int: S = 1..3;
array [1..9] of int: X_INTRODUCED_0_;
array [S,C] of int: x = array2d(1..3,1..3,X_INTRODUCED_0_);
int: sumx = sum([x[i,j] | i in S, j in C]);
