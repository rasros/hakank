output (["tree           : ",show(tree),"\n","number of trees: ",show(num_trees),"\n"]++[if j==1 then "\n" else " " endif++show(parents[i,j]) | i,j in 1..n])++["\n"];
int: n = 8;
int: num_trees = 7;
array [1..n] of int: tree;
array [1..64] of int: X_INTRODUCED_24_;
array [1..n,1..n] of int: parents = array2d(1..8,1..8,X_INTRODUCED_24_);
