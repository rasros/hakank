output ((["diag1: ",show(diag1)," diag2: ",show(diag2),"\n","row_sums: ",show(row_sums),"\n","col_sums: ",show(col_sums),"\n"]++[show(mat[i,j])++if j mod n==0 then "\n" else " " endif | i in 1..n, j in 1..n])++["mat: "++show(mat)])++["\n"];
