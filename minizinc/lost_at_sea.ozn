output (([((((((((((((("x     : "++show(x))++"\n")++"y     : ")++show(y))++"\n")++"points: ")++show(points))++"\n")++"sum_points: ")++show(sum_points))++"\n")++"path: ")++show(path))++"\n"]++["\n"])++[(((((("("++show(x[i]))++", ")++show(y[i]))++"): ")++show(points[i]))++if fix(points[i])==1 then " point" else " points" endif)++"\n" | i in 1..max_steps])++["\n"];
int: max_steps = 10;
array [1..max_steps] of int: x;
array [1..max_steps] of int: y;
array [1..max_steps] of int: points;
int: sum_points;
array [1..max_steps] of int: path;
