output [if m==1 then "\n" else " " endif++show(x[i,j,k,m]) | i in N, j in F, k in R, m in C]++["\n"];
set of int: C = 1..3;
set of int: R = 1..3;
set of int: F = 1..2;
set of int: N = 1..2;
array [1..36] of int: X_INTRODUCED_0_;
array [N,F,R,C] of int: x = array4d(1..2,1..2,1..3,1..3,X_INTRODUCED_0_);
