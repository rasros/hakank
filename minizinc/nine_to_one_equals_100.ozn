output ((["x  : ",show(x),"\n","y  : ",show(y),"\n","ops: ",show(ops),"\n","s  : ",show(s),"\n","s[n]: ",show(s[n]),"\n"]++["sol: "])++[if fix(y[i]) > 0 then if fix(ops[i])==1 then "+" else "-" endif++show(y[i]) else "" endif | i in 1..n])++["\n"];
int: n = 9;
set of int: d = 1..9;
array [d] of int: s;
array [1..n] of int: ops;
array [d] of int: y;
array [d] of int: x;
