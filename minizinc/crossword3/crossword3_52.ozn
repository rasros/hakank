output ([(((("\n"++problem_name)++"\n")++"L:")++show(L))++"\n"]++[if problem[i,j]==0 then "*" else show(letters[fix(L[problem[i,j]])]) endif++if j==cols then "\n" else "" endif | i in 1..rows, j in 1..cols])++["\n"];
string: problem_name = "puzzle03, 4 x 4";
int: N = 14;
int: num_letters = 26;
array [1..15] of int: X_INTRODUCED_16_;
array [0..N] of int: L = array1d(0..14,X_INTRODUCED_16_);
int: cols = 4;
int: rows = 4;
array [1..rows,1..cols] of int: problem = [|1,2,3,0|4,5,6,7|8,9,10,11|0,12,13,14|];
array [1..num_letters] of string: letters = ["a","b","c","d","e","f","g","h","i","j","k","l","m","n","o","p","q","r","s","t","u","v","w","x","y","z"];
