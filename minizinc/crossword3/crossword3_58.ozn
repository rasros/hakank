output let {array [int] of string: X_INTRODUCED_510_ = ([(((("\n"++problem_name)++"\n")++"L:")++show(L))++"\n"]++[if problem[i,j]==0 then "*" else show(letters[fix(L[problem[i,j]])]) endif++if j==cols then "\n" else "" endif | i in 1..rows, j in 1..cols])++["\n"]} in (X_INTRODUCED_510_);
