output (["cost: ",show(cost),"\n","x: "]++[if j==1 then "\n" else "\t" endif++show(x[i,j]) | i in I, j in J])++["\n"];
set of int: J = 1..3;
set of int: I = 1..2;
array [I,J] of float: c = [|0.225,0.153,0.162|0.225,0.162,0.126|];
array [1..6] of float: X_INTRODUCED_0_;
array [I,J] of float: x = array2d(1..2,1..3,X_INTRODUCED_0_);
float: cost = sum([c[i,j]*x[i,j] | i in I, j in J]);
