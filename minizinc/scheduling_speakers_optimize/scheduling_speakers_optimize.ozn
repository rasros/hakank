output let {array [int] of string: X_INTRODUCED_94_ = ["Starting:  ",show(starting_slot),"\n","Durations: ",show(app_durations),"\n","Ends:      ",show(ending_slot),"\n","z:         ",show(z),"\n"]++[if s==1 then "\n" else " " endif++if fix(m[t,s])==-1 then "Busy    " elseif fix(m[t,s])==1 then "SELECTED" else "        " endif | t in 1..num_slots, s in 1..num_speakers]} in (X_INTRODUCED_94_);
int: num_speakers = 3;
int: num_slots = 6;
array [1..num_speakers] of int: ending_slot;
int: z = max([ending_slot[i] | i in 1..num_speakers]);
array [1..num_speakers] of int: app_durations = [1,2,1];
array [1..num_speakers] of int: starting_slot;
array [1..18] of int: X_INTRODUCED_22_;
array [1..num_slots,1..num_speakers] of int: m = array2d(1..6,1..3,X_INTRODUCED_22_);
