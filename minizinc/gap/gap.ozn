set of int: I = 1..5;
array [I,J] of int: c = [|17,21,22,18,24,15,20,18,19,18,16,22,24,24,16|23,16,21,16,17,16,19,25,18,21,17,15,25,17,24|16,20,16,25,24,16,17,19,19,18,20,16,17,21,24|19,19,22,22,20,16,19,17,21,19,25,23,25,25,25|18,19,15,15,21,25,16,16,23,15,22,17,19,22,24|];
array [1..75] of int: X_INTRODUCED_0_;
array [I,J] of int: x = array2d(1..5,1..15,X_INTRODUCED_0_);
