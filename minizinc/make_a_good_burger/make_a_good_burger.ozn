output let {array [int] of string: X_INTRODUCED_59_ = ["total   : ",show(total)," cent\n","sodium  : ",show(sum([x[i]*items[i,1] | i in 1..num_items]))," mg\n","fat     : ",show(sum([x[i]*items[i,2] | i in 1..num_items]))," g\n","calories: ",show(sum([x[i]*items[i,3] | i in 1..num_items])),"\n","x       : ",show(x),"\n"]++[((((show(names[i])++": ")++show(x[i]))++" (")++show_int(3,x[i]*items[i,4]))++" cent)\n" | i in 1..num_items]} in (X_INTRODUCED_59_);
