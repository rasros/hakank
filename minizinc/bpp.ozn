output (["\nx:"]++[if j==1 then "\n" else " " endif++show(x[i,j]) | i in I, j in J])++["\nused: ",show(used),"\n","bin_total: ",show(bin_total),"\n","obj: ",show(obj),"\n"];
set of int: J = 1..6;
set of int: I = 1..6;
array [1..36] of int: X_INTRODUCED_0_;
array [I,J] of int: x = array2d(1..6,1..6,X_INTRODUCED_0_);
array [J] of int: used;
int: obj = sum([used[j] | j in J]);
array [J] of int: bin_total;
