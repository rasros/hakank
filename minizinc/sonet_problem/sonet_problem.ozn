output let {array [int] of string: X_INTRODUCED_62_ = (["z: ",show(z)]++[if client==1 then "\n" else " " endif++show(rings[ring,client]) | ring in 1..r, client in 1..n])++["\n"]} in (X_INTRODUCED_62_);
