output ["z: "++format(z)++"\n","x: "++format(x)++"\n","rows: "++format(rows)++"\ncols: "++format(cols)++"\n"]++[show([m[r,c] | c in 1..cols where fix(x[c])==1])++"\n" | r in 1..rows];
int: rows = 5;
int: cols = 4;
array [1..cols] of int: x;
int: z = sum(x);
array [1..rows,1..cols] of int: m = [|2,1,0,0|2,0,0,0|2,1,2,2|1,2,2,2|2,1,1,0|];
