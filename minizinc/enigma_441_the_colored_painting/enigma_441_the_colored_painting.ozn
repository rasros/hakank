output ["rows_order: "++format(rows_order)++"\n","cols_order: "++format(cols_order)++"\n"]++[""++format([rows[i,j] | j in 1..n])++"\n" | i in fix(rows_order)];
int: n = 6;
array [1..n] of int: cols_order;
array [1..n] of int: rows_order;
array [1..n,1..n] of int: rows = [|3,2,3,1,2,1|1,3,3,2,1,2|2,2,1,3,1,3|1,1,2,3,2,3|2,3,1,1,3,2|3,1,2,2,3,1|];
