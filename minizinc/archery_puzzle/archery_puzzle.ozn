output let {array [int] of string: X_INTRODUCED_22_ = ["targets: ",show(targets),"\n","x: ",show(x),"\n","z: ",show(z),"\n","diffz: ",show(diffz),"\n\n"]++[if fix(x[i]) > 0 then ""++format(fix(x[i]))++" hits on score "++format(targets[i])++"\n" else "" endif | i in 1..n where fix(x[i]) > 0]} in (X_INTRODUCED_22_);
