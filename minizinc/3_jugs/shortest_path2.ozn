output [((if i==1 /\ j==1 then (((((((("total_cost: "++show(total_cost))++"\n")++"inFlow:  ")++show(inFlow))++"\n")++"outFlow: ")++show(outFlow))++"\n")++"    1 2 3 4 5 6\n" else "" endif++if j==1 then show(i)++" : " else "" endif)++show_int(4,x[i,j]))++if j==n then "\n" else " " endif | i in 1..n, j in 1..n];
int: n = 6;
int: M = 9999;
array [1..n,1..n] of int: d = [|0,4,3,9999,9999,9999|9999,0,9999,3,2,9999|9999,9999,0,9999,3,9999|9999,9999,9999,0,9999,2|9999,9999,9999,9999,0,2|9999,9999,9999,9999,9999,0|];
array [1..36] of int: X_INTRODUCED_0_;
array [1..n,1..n] of int: x = array2d(1..6,1..6,X_INTRODUCED_0_);
int: total_cost = sum([d[i,j]*x[i,j] | i in 1..n, j in 1..n where d[i,j] < M]);
array [1..n] of int: inFlow;
array [1..n] of int: outFlow;
