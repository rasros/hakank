output ((["tcost: ",show(tcost),"\n","d:"]++[if j==1 then "\n" else " " endif++show(d[i,j]) | i in ndepts, j in ncities])++["\n"])++["\n"];
set of int: ncities = 1..3;
set of int: ndepts = 1..5;
array [1..15] of int: X_INTRODUCED_0_;
array [ndepts,ncities] of int: d = array2d(1..5,1..3,X_INTRODUCED_0_);
float: tcost;
