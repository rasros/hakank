output [((if i==0 /\ j==1 /\ k==1 then "\n\nGame:" else "" endif++if j==1 /\ k==1 then "\n" else "" endif)++if k==1 then "\n" else " " endif)++show(tickTackToe[i,j,k]) | i in STEPS0, j,k in LENGTH]++["\n"];
