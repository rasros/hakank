output [((((((("sessions: "++show(sessions))++"\n")++"slots: ")++show(slots))++"\n")++"num_time_slots: ")++show(num_time_slots))++"\n"];
int: num_sessions = 11;
int: max_time_slots = 11;
array [1..num_sessions] of int: sessions;
array [1..max_time_slots] of set of int: slots;
int: num_time_slots = max(sessions);
