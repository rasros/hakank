output ["z: ",show(z),"\n","assigned: ",show(assigned),"\n","costs: ",show(costs),"\n"]++[if j==1 then "\n" else " " endif++show(x[i,j]) | i in I, j in J];
set of int: I = 1..8;
array [I] of int: costs;
set of int: J = 1..8;
array [I] of int: assigned;
int: z;
array [1..64] of int: X_INTRODUCED_16_;
array [I,J] of int: x = array2d(1..8,1..8,X_INTRODUCED_16_);
