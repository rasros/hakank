output let {array [int] of string: X_INTRODUCED_99_ = (["\njobs: ",show(jobs),"\n","summax: ",show(summax)]++[if j==1 then "\n" else " " endif++show(x[i,j]) | i in 1..rows, j in 1..cols])++["\n"]} in (X_INTRODUCED_99_);
int: summax;
int: rows = 5;
int: cols = 5;
array [1..rows] of int: jobs;
array [1..25] of int: X_INTRODUCED_0_;
array [1..rows,1..cols] of int: x = array2d(1..5,1..5,X_INTRODUCED_0_);
