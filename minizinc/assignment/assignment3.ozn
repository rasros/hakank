output [(if i==1 /\ j==1 then "\ntotal_cost: "++show(total_cost) else "" endif++if j==1 then "\n" else " " endif)++show(x[i,j]) | i in 1..rows, j in 1..cols]++["\n"];
int: cols = 4;
int: rows = 4;
array [1..16] of int: X_INTRODUCED_0_;
array [1..rows,1..cols] of int: x = array2d(1..4,1..4,X_INTRODUCED_0_);
array [1..rows,1..cols] of int: cost = [|7,5,8,2|7,8,9,4|3,5,7,9|5,5,6,7|];
int: total_cost = sum([x[i,j]*cost[i,j] | i in 1..rows, j in 1..cols]);
