output let {array [int] of string: X_INTRODUCED_120_ = [(if i==1 /\ j==1 then "\ntotal_sum: "++show(total_sum) else "" endif++if j==1 then "\n" else " " endif)++show(x[i,j]) | i in 1..rows, j in 1..cols]} in (X_INTRODUCED_120_);
