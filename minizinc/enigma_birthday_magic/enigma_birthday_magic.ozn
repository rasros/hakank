output (["\nday: ",show(day),"\n","month: ",show(month),"\n","year: ",show(year),"\n","age: ",show(age)]++[if j==1 then "\n" else " " endif++show(x[i,j]) | i,j in 1..n])++["\n"];
int: age;
int: year;
int: month;
int: day;
int: n = 4;
array [1..16] of int: X_INTRODUCED_0_;
array [1..n,1..n] of int: x = array2d(1..4,1..4,X_INTRODUCED_0_);
