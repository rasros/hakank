output [(if i==1 /\ j==1 then ((("\nborder_sum: "++show(border_sum))++"\n")++"total_sum: ")++show(total_sum) else "" endif++if j==1 then "\n" else " " endif)++show(x[i,j]) | i in 1..n, j in 1..n]++["\n"];
int: border_sum = 9;
int: n = 3;
int: total_sum;
array [1..9] of int: X_INTRODUCED_0_;
array [1..n,1..n] of int: x = array2d(1..3,1..3,X_INTRODUCED_0_);
