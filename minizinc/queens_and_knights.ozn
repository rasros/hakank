output ["z: "++format(z)++"\nqueens: "++format(queens)++"\nknights: "++format(knights)++"\n"]++[if j==1 then "\n" else " " endif++if fix(x[i,j])==1 then "Q" elseif fix(x[i,j])==2 then "K" else "_" endif | i,j in 1..n];
int: n = 8;
array [1..64] of int: X_INTRODUCED_16_;
array [1..n,1..n] of int: x = array2d(1..8,1..8,X_INTRODUCED_16_);
int: queen = 1;
int: queens = sum([bool2int(x[i,j]==queen) | i,j in 1..n]);
int: knight = 2;
int: knights = sum([bool2int(x[i,j]==knight) | i,j in 1..n]);
int: z = queens+knights;
