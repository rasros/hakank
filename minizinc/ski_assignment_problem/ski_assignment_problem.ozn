output let {array [int] of string: X_INTRODUCED_123_ = [((show(z)++"\n")++show(x))++"\n"]} in (X_INTRODUCED_123_);
int: num_skiers = 5;
int: num_skis = 6;
array [1..num_skiers] of int: x;
array [1..num_skis] of int: ski_heights = [1,2,5,7,13,21];
array [1..num_skiers] of int: skier_heights = [3,4,7,11,18];
int: z = sum([bool2int(x[i]==j)*abs(ski_heights[j]-skier_heights[i]) | i in 1..num_skiers, j in 1..num_skis]);
