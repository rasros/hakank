output let {array [int] of string: X_INTRODUCED_149_ = [(if i==1 /\ j==1 then "\nmoves: "++show(moves) else "" endif++if j==1 then "\n" else " " endif)++show(x[i,j]) | i in N, j in N]++["\n"]} in (X_INTRODUCED_149_);
