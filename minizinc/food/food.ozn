float: storagecost = 5.0;
float: storage_costs = sum([storagecost*stock[m,o] | m in month, o in oils]);
array [month,oils] of float: buyingprices = [|110.0,120.0,130.0,110.0,115.0|130.0,130.0,110.0,90.0,115.0|110.0,140.0,130.0,100.0,95.0|120.0,110.0,120.0,120.0,125.0|100.0,120.0,150.0,110.0,105.0|90.0,100.0,140.0,80.0,135.0|];
float: buying_costs = sum([buyingprices[m,o]*buys[m,o] | m in month, o in oils]);
