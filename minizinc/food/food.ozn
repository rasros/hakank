output let {array [int] of string: X_INTRODUCED_342_ = [((((((((((((((((((((((((((((((((((((((((((("\nMonth: "++show(m))++"\nPRODUCE: ")++show(production[m]))++" tons, hardness xxx\n")++"\tVEG1   VEG2    OIL1    OIL2    OIL3\n")++"STOCK")++show(m))++"\t")++show(stock[m,1]))++" ")++show(stock[m,2]))++" ")++show(stock[m,3]))++" ")++show(stock[m,4]))++" ")++show(stock[m,5]))++"\n")++"BUYS")++show(m))++"\t")++show(buys[m,1]))++" ")++show(buys[m,2]))++" ")++show(buys[m,3]))++" ")++show(buys[m,4]))++" ")++show(buys[m,5]))++"\n")++"USE")++show(m))++"\t")++show(useoil[m,1]))++" ")++show(useoil[m,2]))++" ")++show(useoil[m,3]))++" ")++show(useoil[m,4]))++" ")++show(useoil[m,5]))++"\n" | m in month]++["Total profit: ",show(totalprofit),"\n","turnover: ",show(turnover),"\n","byuing costs: ",show(buying_costs),"\n","storage costs: ",show(storage_costs),"\n"]} in (X_INTRODUCED_342_);
