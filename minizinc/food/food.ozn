array [month] of float: production;
set of int: oils = 1..5;
array [1..30] of float: X_INTRODUCED_31_;
array [month,oils] of float: stock = array2d(1..6,1..5,X_INTRODUCED_31_);
array [1..30] of float: X_INTRODUCED_0_;
array [month,oils] of float: buys = array2d(1..6,1..5,X_INTRODUCED_0_);
array [1..30] of float: X_INTRODUCED_68_;
