output ((([if use_soft_constraints==1 then "Using soft constraints\n" else "Using hard constraints\n" endif]++[if j==0 then "\n" else " " endif++show(x[i,j]) | i,j in 0..n-1])++[if j==0 then "\n" else " " endif++show(obj[fix(x[i,j])]) | i,j in 0..n-1])++[((((((((((("\n"++"prefs    : ")++show(prefs))++"\n")++"satis    : ")++show(satis))++"\n")++"sat_prefs: ")++show(sat_prefs))++"\n")++"max_prefs: ")++show(max_prefs))++"\n"])++["\n"];
int: use_soft_constraints = 1;
int: n = 3;
int: m = 6;
array [1..9] of int: X_INTRODUCED_16_;
array [0..n-1,0..n-1] of int: x = array2d(0..2,0..2,X_INTRODUCED_16_);
array [0..m] of string: obj = array1d(0..6,["<empty>            ","japanese restaurant","hairstylist        ","clothing store     ","toy store          ","fish_and_chips     ","health_store       "]);
int: num_constraints = 7;
array [1..num_constraints] of int: prefs = [0,0,1,1,1,0,0];
array [1..num_constraints] of int: satis;
array [1..num_constraints] of int: sat_prefs;
int: max_prefs = sum(sat_prefs);
