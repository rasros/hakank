output [((("total_steps: "++show(total_steps))++"\n")++"total: ")++show(total)]++[if p==1 /\ t<=fix(total_steps) then "\n" else " " endif++if t<=fix(total_steps) then show(actions[t,p])++if p==num_persons then ((" torch: "++show(torch_place[t]))++" transfered: ")++show(transfered[t]) else "" endif else "" endif | t in 1..max_time, p in 1..num_persons];
int: max_time = 3;
int: total_steps;
int: num_persons = 3;
array [1..max_time] of int: times;
int: total = sum([times[t]*bool2int(t<=total_steps) | t in 1..max_time]);
array [1..9] of int: X_INTRODUCED_0_;
array [1..max_time,1..num_persons] of int: actions = array2d(1..3,1..3,X_INTRODUCED_0_);
array [1..max_time] of int: torch_place;
array [1..max_time] of set of int: transfered;
