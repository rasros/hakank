output [if j==1 then "\n" else " " endif++show(x[i,j]) | i,j in 1..n]++["\n","TopConstraint   : ",show(TopConstraint),"\n","RightConstraint : ",show(RightConstraint),"\n","BottomConstraint: ",show(BottomConstraint),"\n","LeftConstraint  : ",show(LeftConstraint),"\n"];
int: n = 5;
array [1..25] of int: X_INTRODUCED_16_;
array [1..n,1..n] of int: x = array2d(1..5,1..5,X_INTRODUCED_16_);
array [1..n] of int: LeftConstraint = [5,5,5,5,5];
array [1..n] of int: BottomConstraint = [3,4,6,3,7];
array [1..n] of int: RightConstraint = [5,5,5,5,5];
array [1..n] of int: TopConstraint = [7,6,4,7,3];
