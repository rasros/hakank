output [(((("x: "++show(x))++"\n")++"total_weight: ")++show(total_weight))++"\n"];
int: n = 8;
array [1..n] of int: x;
int: t = 4;
array [1..n,1..t+1] of int: A = [|1,70,0,0,200|1,100,0,0,250|1,150,0,0,350|2,-30,500,0,140|2,-50,800,0,300|3,-20,0,250,20|3,-25,0,300,25|3,-30,0,400,30|];
array [1..t+1] of int: unit_cost = [0,0,0,0,1];
int: total_weight = sum([x[i]*A[i,j]*unit_cost[j] | i in 1..n, j in 1..t+1]);
