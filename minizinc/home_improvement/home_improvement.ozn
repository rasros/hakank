output ([(((((("x:"++show(x))++"\n")++"sum_rest: ")++show(sum_rest))++"\n")++"max: ")++show(max_rest)]++[(if j==1 then "\n" else " " endif++show(rest[i,j]))++" " | i in 1..num_houses, j in 1..num_improvements])++["\n"];
