output let {array [int] of string: X_INTRODUCED_48_ = [(if i==1 /\ j==1 then ("sum_profit: "++show(sum_profit))++"\n" else "" endif++if j==1 then "\n" else " " endif)++show(x[i,j]) | i in w, j in p]++["\n"]} in (X_INTRODUCED_48_);
set of int: p = 1..4;
set of int: w = 1..4;
array [1..16] of int: X_INTRODUCED_0_;
array [w,p] of int: x = array2d(1..4,1..4,X_INTRODUCED_0_);
array [w,p] of int: profit = [|7,1,3,4|8,2,5,1|4,3,7,2|3,1,6,3|];
int: sum_profit = sum([x[i,j]*profit[i,j] | i in w, j in p]);
