output (["nsold: ",show(nsold),"\n","p:     ",show(p)]++[if j==1 then "\n" else " " endif++show(x[i,j]) | i in M, j in N])++["\n"];
set of int: N = 1..2;
array [N] of int: p;
set of int: M = 1..3;
array [M] of int: nsold = [10,25,30];
array [1..6] of int: X_INTRODUCED_0_;
array [M,N] of int: x = array2d(1..3,1..2,X_INTRODUCED_0_);
